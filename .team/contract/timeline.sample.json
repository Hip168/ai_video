      "beats": [
        {
          "id": "s17",
          "startFrame": 1963,
          "durationFrames": 119,
          "text": "Tin nhắn lại được chia thành các packet, đi qua mạng tới điện thoại của người nhận.",
          "cue": "deliver"
        },
        {
          "id": "s18",
          "startFrame": 2089,
          "durationFrames": 98,
          "text": "Điện thoại rung lên, và dòng chữ của bạn hiện ra trên màn hình.",
          "cue": "notify"
        },
        {
          "id": "s19",
          "startFrame": 2194,
          "durationFrames": 98,
          "text": "Cả chặng đường ấy, từ đầu đến cuối, thường chỉ mất khoảng một giây.",
