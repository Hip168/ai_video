        {
          "id": "s13",
          "startFrame": 1447,
          "durationFrames": 132,
          "text": "Vì vậy, các packet có thể đi những con đường khác nhau và đến nơi không đúng thứ tự.",
          "cue": "paths"
        }
      ]
    },
    {
      "id": "server",
      "startFrame": 1593,
      "durationFrames": 370,
      "beats": [
        {
          "id": "s14",
          "startFrame": 1593,
          "durationFrames": 132,
          "text": "Tại máy chủ, các packet được sắp xếp lại theo số thứ tự, ghép thành tin nhắn ban đầu.",
          "cue": "reorder"
        },
        {
          "id": "s15",
          "startFrame": 1733,
          "durationFrames": 97,
          "text": "Nếu thiếu mất packet nào, máy chủ sẽ yêu cầu gửi lại phần đó.",
