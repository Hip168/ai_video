  "scenes": [
    {
      "id": "sc01",
      "chapter": "mo-dau",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b001",
          "text": "Mở cửa sổ lập trình của trình duyệt, gõ một phép cộng lớp ba: 0.1 + 0.2.",
          "spoken": "Mở cửa sổ lập trình của trình duyệt, gõ một phép cộng lớp ba: không phẩy một cộng không phẩy hai.",
          "cue": null,
          "pause_ms": 300,
          "sfx": null,
          "claims": [
            "c001"
          ]
        },
        {
          "id": "b002",
          "text": "Máy trả lời: 0.30000000000000004.",
          "spoken": "Máy trả lời: không phẩy ba, mười lăm số không, rồi số bốn.",
          "cue": "hook",
          "pause_ms": 600,
          "sfx": null,
          "claims": [
            "c001"
          ]
        },
        {
          "id": "b003",
          "text": "Hỏi tiếp: kết quả ấy có bằng 0.3 không? Máy đáp: false, tức là không.",
          "spoken": "Hỏi tiếp: kết quả ấy có bằng không phẩy ba không? Máy đáp: phôn, tức là không.",
          "cue": null,
          "pause_ms": 300,
          "sfx": null,
          "claims": [
            "c001"
          ]
        },
        {
          "id": "b004",
          "text": "Sang Python cũng thế: 0.1 + 0.1 + 0.1 không bằng 0.3.",
          "spoken": "Sang pai-thơn cũng thế: cộng ba lần không phẩy một, kết quả không bằng không phẩy ba.",
          "cue": null,
          "pause_ms": 600,
          "sfx": null,
          "claims": [
            "c002"
          ]
        }
      ]
    },
    {
      "id": "sc02",
      "chapter": "mo-dau",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b005",
          "text": "Đây không phải lỗi của trình duyệt, cũng không phải lỗi của Python.",
          "spoken": null,
          "cue": null,
          "pause_ms": 300,
          "sfx": null,
          "claims": [
            "c042"
          ]
        },
        {
          "id": "b006",
          "text": "Hầu hết máy tính ngày nay đều cộng ra đúng như vậy.",
          "spoken": null,
          "cue": null,
          "pause_ms": 300,
          "sfx": null,
          "claims": [
            "c008"
          ]
        },
        {
          "id": "b007",
          "text": "Mà lệch ở chữ số thứ 17 sau dấu phẩy thì có gì đáng ngại?",
          "spoken": null,
          "cue": null,
          "pause_ms": 600,
          "sfx": null,
          "claims": [
            "c001",
            "c043"
          ]
        }
      ]
    },
    {
      "id": "sc03",
      "chapter": "mo-dau",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b008",
          "text": "Năm 1991, sai số của chính con số 0,1 khiến một hệ thống phòng thủ tên lửa không chặn được mục tiêu.",
          "spoken": null,
          "cue": null,
          "pause_ms": 300,
          "sfx": null,
          "claims": [
            "c025",
            "c033"
          ]
        },
        {
          "id": "b009",
          "text": "Cuối video, ta sẽ quay lại câu chuyện đó.",
          "spoken": null,
          "cue": null,
          "pause_ms": 300,
          "sfx": null,
          "claims": []
        },
        {
          "id": "b010",
          "text": "Nhưng trước hết, hãy xem vì sao một con số giản dị như 0,1 lại làm khó máy tính.",
          "spoken": null,
          "cue": null,
          "pause_ms": 900,
          "sfx": null,
          "claims": [
            "c006"
          ]
        }
      ]
    },
    {
      "id": "sc04",
      "chapter": "chuong-1",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b011",
          "text": "Bắt đầu bằng một phép chia quen thuộc: 1 chia 3.",
          "spoken": null,
          "cue": null,
          "pause_ms": 300,
          "sfx": null,
          "claims": [
            "c003",
            "c038"
          ]
        },
        {
          "id": "b012",
          "text": "Ta được 0,333..., số 3 cứ thế lặp mãi.",
          "spoken": null,
          "cue": null,
          "pause_ms": 300,
          "sfx": null,
          "claims": [
            "c003",
            "c038"
          ]
        },
        {
          "id": "b013",
          "text": "Viết bao nhiêu chữ số cũng chưa bằng đúng 1/3, chỉ ngày càng gần hơn mà thôi.",
          "spoken": null,
          "cue": null,
          "pause_ms": 600,
          "sfx": null,
          "claims": [
            "c003"
          ]
        }
      ]
    },
    {
      "id": "sc05",
      "chapter": "chuong-1",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b013a",
          "text": "Nhưng không phải phân số nào cũng thế. Thử vài ví dụ trong hệ mười, tức hệ thập phân.",
          "spoken": null,
          "cue": null,
          "pause_ms": 300,
          "sfx": null,
          "claims": []
        },
        {
          "id": "b013b",
          "text": "1/4 là 0,25, dừng ngay. 1/5 là 0,2, cũng dừng.",
          "spoken": null,
          "cue": null,
          "pause_ms": 300,
          "sfx": null,
          "claims": [
            "c037"
          ]
        },
        {
          "id": "b013c",
          "text": "1/3 thì lặp mãi. 1/7 là 0,142857142857..., khối 142857 lặp lại mãi, không bao giờ dừng.",
          "spoken": "Một phần ba thì lặp mãi. Một phần bảy là không phẩy một bốn hai tám năm bảy, rồi khối sáu chữ số ấy lặp lại mãi, không bao giờ dừng.",
          "cue": null,
          "pause_ms": 300,
          "sfx": null,
          "claims": [
            "c038"
          ]
        },
        {
          "id": "b013d",
          "text": "Bí quyết nằm ở mẫu số. Hệ mười xây trên số 10, mà 10 bằng 2 nhân 5.",
          "spoken": null,
          "cue": null,
          "pause_ms": 300,
          "sfx": null,
          "claims": [
            "c039"
          ]
        },
        {
          "id": "b013e",
          "text": "Mẫu số chỉ gồm các số 2 và 5 nhân với nhau, như 4 hay 5, thì viết gọn.",
          "spoken": null,
          "cue": null,
          "pause_ms": 300,
          "sfx": null,
          "claims": [
            "c039"
          ]
        },
        {
          "id": "b013f",
          "text": "Còn mẫu số có số khác chen vào, như 3 hay 7, thì không bao giờ có điểm dừng.",
          "spoken": null,
          "cue": null,
          "pause_ms": 600,
          "sfx": null,
          "claims": [
            "c039"
          ]
        }
      ]
    },
    {
      "id": "sc06",
      "chapter": "chuong-1",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b013g",
          "text": "Máy tính thì không dùng hệ mười. Như tập trước, máy chỉ có hai chữ số là không và một.",
          "spoken": null,
          "cue": null,
          "pause_ms": 300,
          "sfx": null,
          "claims": []
        },
        {
          "id": "b013h",
          "text": "Đó là hệ hai, tức hệ nhị phân. Nó xây trên số 2, không có số 5 nào cả.",
          "spoken": null,
          "cue": null,
          "pause_ms": 300,
          "sfx": null,
          "claims": [
            "c040"
          ]
        },
        {
          "id": "b013i",
          "text": "Nên nó chỉ viết gọn được phân số có mẫu là 2, 4, 8, 16, cứ thế nhân đôi.",
          "spoken": null,
          "cue": null,
          "pause_ms": 300,
          "sfx": null,
          "claims": [
            "c040"
          ]
        },
        {
          "id": "b019",
          "text": "Còn 0,1 là một phần mười, mà 10 có thừa số 5. Với hệ hai, thừa số 5 ấy là ngõ cụt.",
          "spoken": null,
          "cue": null,
          "pause_ms": 600,
          "sfx": null,
          "claims": [
            "c040"
          ]
        }
      ]
    },
    {
      "id": "sc07",
      "chapter": "chuong-1",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b020",
          "text": "Kết quả: trong hệ nhị phân, 1/10 là một phân số lặp vô hạn.",
          "spoken": null,
          "cue": null,
          "pause_ms": 300,
          "sfx": null,
          "claims": [
            "c004"
          ]
        },
        {
          "id": "b021",
          "text": "Nó trông như thế này: 0,0001100110011..., và cứ thế lặp mãi.",
          "spoken": "Nó trông như thế này: không phẩy không không không, một một, không không, một một, và cứ thế lặp mãi.",
          "cue": null,
          "pause_ms": 300,
          "sfx": null,
          "claims": [
            "c004"
          ]
        },
        {
          "id": "b022",
          "text": "1/10 trong hệ hai cũng tương tự 1/3 trong hệ mười: viết mãi không hết.",
          "spoken": null,
          "cue": null,
          "pause_ms": 600,
          "sfx": null,
          "claims": [
            "c005"
          ]
        },
        {
          "id": "b022a",
          "text": "Mà trong máy, mỗi con số chỉ được cấp một số bit nhất định, tức một số ô chứa không hoặc một.",
          "spoken": null,
          "cue": null,
          "pause_ms": 300,
          "sfx": null,
          "claims": [
            "c004"
          ]
        },
        {
          "id": "b024",
          "text": "Nên máy phải cắt ở đâu đó, và cắt ở đâu cũng chỉ được giá trị gần đúng.",
          "spoken": null,
          "cue": null,
          "pause_ms": 300,
          "sfx": null,
          "claims": [
            "c004"
          ]
        },
        {
          "id": "b025",
          "text": "Vậy máy cắt ở đâu, và cất con số ấy ra sao?",
          "spoken": null,
          "cue": null,
          "pause_ms": 900,
          "sfx": null,
          "claims": []
        }
      ]
    },
    {
      "id": "sc08",
      "chapter": "chuong-2",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b026",
          "text": "Câu trả lời nằm trong một bộ luật có tên IEEE 754.",
          "spoken": null,
          "cue": null,
          "pause_ms": 300,
          "sfx": null,
          "claims": [
            "c008"
          ]
        },
        {
          "id": "b027",
          "text": "Ít nhất từ năm 2000, hầu hết máy tính tính số lẻ theo chuẩn này.",
          "spoken": null,
          "cue": null,
          "pause_ms": 300,
          "sfx": null,
          "claims": [
            "c008"
          ]
        },
        {
          "id": "b028",
          "text": "Trong chuẩn ấy, số lẻ được cất dưới dạng số dấu phẩy động.",
          "spoken": null,
          "cue": null,
          "pause_ms": 600,
          "sfx": null,
          "claims": [
            "c008"
          ]
        }
      ]
    },
    {
      "id": "sc09",
      "chapter": "chuong-2",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b029",
          "text": "Ý tưởng giống cách viết khoa học: 1.500 viết thành 1,5 nhân 10 mũ 3.",
          "spoken": null,
          "cue": null,
          "pause_ms": 300,
          "sfx": null,
          "claims": [
            "c041"
          ]
        },
        {
          "id": "b030",
          "text": "Một phần giữ các chữ số, một phần là số mũ cho biết dấu phẩy nằm ở đâu.",
          "spoken": null,
          "cue": null,
          "pause_ms": 300,
          "sfx": null,
          "claims": []
        },
        {
          "id": "b031",
          "text": "Dấu phẩy dịch theo số mũ, nên gọi là dấu phẩy động. Máy làm y vậy, chỉ là với cơ số 2.",
          "spoken": null,
          "cue": null,
          "pause_ms": 600,
          "sfx": null,
          "claims": [
            "c040"
          ]
        }
      ]
    },
    {
      "id": "sc10",
      "chapter": "chuong-2",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b031a",
          "text": "Python và JavaScript dùng kiểu độ chính xác kép: mỗi số chiếm 64 bit.",
          "spoken": null,
          "cue": null,
          "pause_ms": 300,
          "sfx": null,
          "claims": [
            "c008",
            "c009"
          ]
        },
        {
          "id": "b031b",
          "text": "Phần cất các chữ số trong đó chỉ giữ trọn được 15 chữ số có nghĩa.",
          "spoken": null,
          "cue": null,
          "pause_ms": 300,
          "sfx": null,
          "claims": [
            "c012"
          ]
        },
        {
          "id": "b031c",
          "text": "Từ chữ số thứ 16 trở đi đã nằm ngoài phần được giữ trọn.",
          "spoken": null,
          "cue": null,
          "pause_ms": 300,
          "sfx": null,
          "claims": [
            "c012",
            "c044"
          ]
        },
        {
          "id": "b031d",
          "text": "Con số 4 lạ lùng trong 0.30000000000000004 nằm đúng ở vùng đó: chữ số có nghĩa thứ 17.",
          "spoken": "Con số bốn lạ lùng ở cuối kết quả lúc nãy nằm đúng ở vùng đó: chữ số có nghĩa thứ mười bảy.",
          "cue": null,
          "pause_ms": 600,
          "sfx": null,
          "claims": [
            "c001",
            "c012",
            "c043"
          ]
        }
      ]
    },
    {
      "id": "sc11",
      "chapter": "chuong-2",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b040",
          "text": "Giờ quay lại câu hỏi chính: khi bạn gõ 0.1, máy thật sự cất gì?",
          "spoken": null,
          "cue": null,
          "pause_ms": 300,
          "sfx": null,
          "claims": [
            "c006"
          ]
        },
        {
          "id": "b041",
          "text": "Đúng bằng con số này: 0,1000000000000000055511151231257827021181583404541015625.",
          "spoken": "Đúng bằng con số này: không phẩy một, một hàng dài số không, rồi năm năm năm một một, và còn dài nữa.",
          "cue": null,
          "pause_ms": 300,
          "sfx": null,
          "claims": [
            "c006"
          ]
        },
        {
          "id": "b042",
          "text": "Tức phân số 3.602.879.701.896.397 chia cho 2 mũ 55.",
          "spoken": "Tức là một số nguyên rất lớn, chia cho hai mũ năm mươi lăm.",
          "cue": null,
          "pause_ms": 300,
          "sfx": null,
          "claims": [
            "c007"
          ]
        },
        {
          "id": "b043",
          "text": "Rất gần 0,1, nhỉnh hơn một chút xíu. Nhưng không phải 0,1.",
          "spoken": null,
          "cue": null,
          "pause_ms": 900,
          "sfx": null,
          "claims": [
            "c006"
          ]
        }
      ]
    },
    {
      "id": "sc12",
      "chapter": "chuong-3",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b044",
          "text": "Vậy chuyện gì xảy ra khi máy cộng 0.1 với 0.2?",
          "spoken": null,
          "cue": null,
          "pause_ms": 300,
          "sfx": null,
          "claims": [
            "c001"
          ]
        },
        {
          "id": "b045",
          "text": "Chuẩn IEEE 754 có một luật nghiêm cho phép cộng, trừ, nhân, chia.",
          "spoken": null,
          "cue": null,
          "pause_ms": 300,
          "sfx": null,
          "claims": [
            "c015",
            "c008"
          ]
        },
        {
          "id": "b046",
          "text": "Kết quả phải như thể máy đã tính chính xác tuyệt đối, rồi mới làm tròn về số gần nhất.",
          "spoken": null,
          "cue": null,
          "pause_ms": 600,
          "sfx": null,
          "claims": [
            "c015"
          ]
        }
      ]
    },
    {
      "id": "sc13",
      "chapter": "chuong-3",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b046a",
          "text": "Hãy hình dung một cây thước. Máy chỉ cất được những số nằm đúng trên vạch.",
          "spoken": null,
          "cue": null,
          "pause_ms": 300,
          "sfx": null,
          "claims": []
        },
        {
          "id": "b046b",
          "text": "Số nào rơi vào giữa hai vạch thì phải làm tròn về một vạch.",
          "spoken": null,
          "cue": null,
          "pause_ms": 600,
          "sfx": null,
          "claims": [
            "c015"
          ]
        },
        {
          "id": "b046c",
          "text": "0,1 rơi giữa hai vạch. Máy chọn vạch nhỉnh hơn 0,1 một chút.",
          "spoken": null,
          "cue": null,
          "pause_ms": 300,
          "sfx": null,
          "claims": [
            "c006"
          ]
        },
        {
          "id": "b046d",
          "text": "0,2 cũng vậy: máy cất vạch nhỉnh hơn 0,2 một chút.",
          "spoken": null,
          "cue": null,
          "pause_ms": 300,
          "sfx": null,
          "claims": [
            "c045"
          ]
        },
        {
          "id": "b046e",
          "text": "Cộng hai số cùng nhỉnh lên, phần nhỉnh dồn lại. Tổng đã vượt qua 0,3 thật.",
          "spoken": null,
          "cue": null,
          "pause_ms": 600,
          "sfx": null,
          "claims": [
            "c047"
          ]
