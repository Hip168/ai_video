          "sfx": null,
          "claims": [
            "c012",
            "c018"
          ]
        },
        {
          "id": "b118",
          "text": "Nhưng mỗi ứng dụng một luật, một kích thước, một lưới, nên ảnh rỗ dần qua từng chặng.",
          "spoken": null,
          "cue": null,
