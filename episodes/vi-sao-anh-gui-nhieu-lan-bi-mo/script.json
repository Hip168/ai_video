          "pause_ms": 400,
          "sfx": null,
          "claims": [
            "c024"
          ]
        },
        {
          "id": "b090",
          "text": "Messenger cũng thêm nút gửi ảnh HD từ ngày 9/4/2024.",
          "spoken": "Messenger cũng thêm nút gửi ảnh HD từ ngày chín tháng tư năm hai nghìn không trăm hai mươi tư.",
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": [
            "c025"
          ]
        },
        {
          "id": "b091",
          "text": "Có hẳn một nút HD, tức là bình thường ảnh không được gửi ở mức nét nhất.",
          "spoken": null,
          "cue": null,
          "pause_ms": 800,
          "sfx": null,
          "claims": [
            "c024",
            "c025"
          ]
        }
      ]
    },
    {
      "id": "s44",
      "chapter": "chuong-5",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b092",
          "text": "Năm 2016, một nhóm ở Đại học Catania đã đo thật, với 2.720 ảnh qua 10 nền tảng.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": [
            "c020"
          ]
        },
        {
          "id": "b093",
          "text": "Facebook, Twitter, Telegram, WhatsApp và Instagram đều nén lại mọi ảnh được tải lên.",
          "spoken": null,
          "cue": null,
          "pause_ms": 500,
          "sfx": null,
          "claims": [
            "c020"
          ]
        }
      ]
    },
    {
      "id": "s45",
      "chapter": "chuong-5",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b094",
          "text": "Ảnh còn bị thu nhỏ khi cạnh dài vượt một ngưỡng, mỗi nơi một khác.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": [
            "c021"
          ]
        },
        {
          "id": "b095",
          "text": "Theo số đo năm 2016 ấy, ngưỡng của WhatsApp là 1.600 điểm, của Instagram là 1.080.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": [
            "c021"
          ]
        },
        {
          "id": "b096",
          "text": "Nay các ngưỡng này có thể đã khác. Ngay lúc làm thí nghiệm, Twitter đã đổi ngưỡng của mình.",
          "spoken": null,
          "cue": null,
          "pause_ms": 450,
          "sfx": null,
          "claims": [
            "c021"
          ]
        },
        {
          "id": "b097",
          "text": "Cũng theo nghiên cứu ấy, các nền tảng còn xoá thông tin đi kèm ảnh, kể cả thông tin máy chụp.",
          "spoken": null,
          "cue": null,
          "pause_ms": 800,
