          "spoken": null,
          "cue": null,
          "pause_ms": 450,
          "sfx": null,
          "claims": []
        },
        {
          "id": "b048",
          "text": "Chỉ biết mười ba nghìn, bạn không đoán lại được giá gốc. Phần lẻ đã mất hẳn.",
          "spoken": null,
          "cue": null,
          "pause_ms": 500,
