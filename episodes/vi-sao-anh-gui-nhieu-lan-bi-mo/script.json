    {
      "id": "s46",
      "chapter": "chuong-5",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b098",
          "text": "Chụp màn hình một tấm ảnh rồi gửi lại là một cách làm ảnh xấu thêm rất nhanh.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": []
        },
        {
          "id": "b099",
          "text": "Ảnh chụp màn hình chép lại đúng những gì đang hiện, kèm cả vết nén cũ và viền của ứng dụng.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": []
        },
        {
          "id": "b100",
          "text": "Kích thước cũng theo màn hình, không theo ảnh gốc.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": []
        }
      ]
    },
    {
      "id": "s47",
      "chapter": "chuong-5",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b101",
          "text": "Gửi đi, ứng dụng lại thu nhỏ và nén thêm một lần, chia ảnh thành ô theo một lưới mới.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": [
            "c020",
            "c019"
          ]
        },
        {
          "id": "b102",
          "text": "Mà ảnh chụp tin nhắn toàn chữ, nét mảnh, cạnh sắc, lại đúng là loại JPEG nén kém nhất.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": [
            "c017"
          ]
        },
        {
          "id": "b103",
          "text": "Chữ lem quanh viền là vì vậy.",
          "spoken": null,
          "cue": null,
          "pause_ms": 900,
          "sfx": null,
          "claims": []
        }
      ]
    },
    {
      "id": "s48",
      "chapter": "chuong-6",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b104",
          "text": "Có định dạng ảnh nào cứu được chuyện này không?",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": []
        },
        {
          "id": "b105",
          "text": "PNG nén không mất dữ liệu: giải nén ra giống hệt ảnh gốc, tới từng bit.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": [
            "c026"
          ]
        },
        {
          "id": "b106",
          "text": "Định dạng này ra đời sau một vụ ồn ào về phí bản quyền quanh định dạng ảnh GIF.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": [
            "c027"
          ]
        },
        {
          "id": "b107",
          "text": "Nhưng kiểu nén này hợp với hình vẽ và chữ hơn. Với ảnh chụp, tệp thường lớn hơn nhiều.",
          "spoken": null,
          "cue": null,
          "pause_ms": 500,
          "sfx": null,
          "claims": []
        }
      ]
    },
    {
      "id": "s49",
      "chapter": "chuong-6",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b108",
          "text": "Các định dạng mới thì nén giỏi hơn JPEG.",
          "spoken": null,
          "cue": null,
          "pause_ms": 300,
          "sfx": null,
          "claims": [
            "c028"
          ]
        },
        {
          "id": "b109",
          "text": "Theo Google, ảnh WebP nhỏ hơn ảnh JPEG tương đương từ 25 đến 34%.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": [
            "c028"
          ]
        },
        {
          "id": "b110",
          "text": "Apple đưa định dạng HEIF vào iOS 11. Nhưng gửi sang máy chưa hỗ trợ, ảnh có thể tự đổi về JPEG.",
          "spoken": null,
          "cue": null,
          "pause_ms": 500,
          "sfx": null,
          "claims": [
            "c029"
          ]
        }
      ]
    },
    {
      "id": "s50",
