    },
    {
      "id": "chuong-1",
      "title": "Một tấm ảnh nặng bao nhiêu"
    },
    {
      "id": "chuong-2",
      "title": "Bớt màu, và cắt ô tám nhân tám"
    },
    {
      "id": "chuong-3",
      "title": "Làm tròn thô: chỗ ảnh thật sự mất"
    },
    {
      "id": "chuong-4",
      "title": "Mất thế hệ"
    },
    {
      "id": "chuong-5",
      "title": "Ứng dụng làm gì với ảnh của bạn"
    },
    {
      "id": "chuong-6",
      "title": "Định dạng mới có cứu được không"
    },
    {
      "id": "ket",
      "title": "Kết"
    }
  ],
  "scenes": [
    {
      "id": "s01",
      "chapter": "mo-dau",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b001",
          "text": "Bạn chắc từng gặp cảnh này: tấm ảnh cả nhà chụp chung, chuyền qua mấy nhóm chat, tới tay thì nhoè.",
          "spoken": null,
          "cue": null,
          "pause_ms": 500,
          "sfx": null,
          "claims": []
        },
        {
          "id": "b002",
          "text": "Vì sao gửi qua gửi lại vài lần, ảnh lại cứ mờ dần?",
          "spoken": null,
          "cue": null,
          "pause_ms": 600,
          "sfx": null,
          "claims": []
        }
      ]
    },
    {
      "id": "s02",
      "chapter": "mo-dau",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b003",
          "text": "Một phần câu trả lời: chính các ứng dụng chat làm ảnh nhỏ đi và nén lại trước khi gửi.",
          "spoken": null,
          "cue": null,
          "pause_ms": 450,
          "sfx": null,
          "claims": [
            "c001",
            "c020"
          ]
        },
        {
          "id": "b004",
          "text": "Và mỗi lần ảnh bị nén lại, lại có thêm một ít bị vứt đi.",
          "spoken": null,
          "cue": null,
          "pause_ms": 600,
          "sfx": null,
          "claims": [
            "c002"
          ]
        }
      ]
    },
    {
      "id": "s03",
      "chapter": "mo-dau",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b005",
          "text": "Tập này trả lời ba câu hỏi.",
          "spoken": null,
          "cue": null,
          "pause_ms": 300,
          "sfx": null,
          "claims": []
        },
        {
          "id": "b006",
          "text": "Thứ gì trong ảnh bị vứt đi? Vì sao vứt một lần không ai thấy, mà vứt nhiều lần thì ảnh mờ dần?",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": []
        },
        {
          "id": "b007",
          "text": "Và gửi thế nào để người nhận có đúng ảnh gốc?",
          "spoken": null,
          "cue": null,
          "pause_ms": 900,
          "sfx": null,
          "claims": []
        }
      ]
    },
    {
      "id": "s04",
      "chapter": "chuong-1",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b008",
          "text": "Với máy tính, một tấm ảnh chỉ là một lưới điểm, và mỗi điểm là vài con số.",
          "spoken": null,
          "cue": null,
          "pause_ms": 450,
          "sfx": null,
          "claims": []
        }
      ]
    },
    {
      "id": "s05",
      "chapter": "chuong-1",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b009",
          "text": "Mỗi điểm của một ảnh màu thông thường cần 24 bit khi chưa nén.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": [
            "c003"
          ]
        },
        {
          "id": "b010",
          "text": "Nên một ảnh 12 triệu điểm nặng khoảng 36 MB.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": [
            "c003"
          ]
        },
        {
          "id": "b011",
          "text": "Gửi nguyên như thế qua mạng thì vừa chậm, vừa tốn dữ liệu di động.",
          "spoken": null,
          "cue": null,
          "pause_ms": 600,
          "sfx": null,
          "claims": []
        }
      ]
    },
    {
      "id": "s06",
      "chapter": "chuong-1",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b012",
          "text": "Vì vậy ảnh được nén. Với ảnh chụp, cách nén phổ biến nhất là JPEG.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": [
            "c007"
          ]
        },
        {
          "id": "b013",
          "text": "Ủy ban làm chuẩn JPEG gọi nó là định dạng ảnh tĩnh thống trị nhất hiện nay.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": [
            "c007"
          ]
        },
        {
          "id": "b014",
          "text": "Tên JPEG là viết tắt tên một nhóm chuyên gia về ảnh, lập ra từ sự hợp tác của hai tổ chức làm chuẩn.",
          "spoken": null,
          "cue": null,
          "pause_ms": 500,
          "sfx": null,
          "claims": [
            "c006"
          ]
        }
      ]
    },
    {
      "id": "s07",
      "chapter": "chuong-1",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b015",
          "text": "Chuẩn này được xây dựng từ năm 1986, và bản đầu tiên ra đời năm 1992.",
          "spoken": null,
          "cue": null,
          "pause_ms": 500,
          "sfx": null,
          "claims": [
            "c005",
            "c004"
          ]
        }
      ]
    },
    {
      "id": "s08",
      "chapter": "chuong-1",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b016",
          "text": "Bí quyết của JPEG là chịu vứt bớt dữ liệu, nhưng vứt có chọn lọc.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": []
        },
        {
          "id": "b017",
          "text": "Theo bài giới thiệu chuẩn JPEG của kỹ sư Gregory Wallace, kết quả rất đáng kinh ngạc.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": [
            "c004"
          ]
        },
        {
          "id": "b018",
          "text": "Ảnh nhỏ đi khoảng 12 đến 16 lần mà thường vẫn không phân biệt được với ảnh gốc.",
          "spoken": null,
          "cue": null,
          "pause_ms": 600,
          "sfx": null,
          "claims": [
            "c004"
          ]
        }
      ]
    },
    {
      "id": "s09",
      "chapter": "chuong-1",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b019",
          "text": "Vứt gì mà mắt không nhận ra? JPEG làm việc đó qua ba bước.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": []
        },
        {
          "id": "b020",
          "text": "Bớt màu, ghi lại từng ô nhỏ theo cách khác, rồi làm tròn thô.",
          "spoken": null,
          "cue": null,
          "pause_ms": 900,
          "sfx": null,
          "claims": [
            "c009",
            "c010",
            "c012"
          ]
        }
      ]
    },
    {
      "id": "s10",
      "chapter": "chuong-2",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b021",
          "text": "Bước một dựa vào một điểm yếu của mắt người.",
          "spoken": null,
          "cue": null,
          "pause_ms": 300,
          "sfx": null,
          "claims": []
        },
        {
          "id": "b022",
          "text": "Mắt người nhạy với thay đổi về độ sáng hơn là thay đổi về màu.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": [
            "c008"
          ]
        },
        {
          "id": "b023",
          "text": "Nên phần màu có thể bị bớt chi tiết nhiều hơn, mà ta không thấy ảnh kém đi.",
          "spoken": null,
          "cue": null,
          "pause_ms": 500,
          "sfx": null,
          "claims": [
            "c008"
          ]
        }
      ]
    },
    {
      "id": "s11",
      "chapter": "chuong-2",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b024",
          "text": "Khi nén, JPEG thường tách ảnh thành một lớp độ sáng và hai lớp màu.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": [
            "c009"
          ]
        },
        {
          "id": "b025",
          "text": "Mỗi lớp màu thường chỉ giữ một nửa chiều ngang và một nửa chiều dọc, tức còn một phần tư số điểm.",
          "spoken": null,
          "cue": null,
          "pause_ms": 500,
          "sfx": null,
          "claims": [
            "c009"
          ]
        }
      ]
    },
    {
      "id": "s12",
      "chapter": "chuong-2",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b026",
          "text": "Hình dung một ảnh đen trắng thật nét, phủ lên một lớp màu hơi nhoè. Mắt vẫn thấy như ảnh thật.",
          "spoken": null,
          "cue": null,
          "pause_ms": 700,
          "sfx": null,
          "claims": []
        }
      ]
    },
    {
      "id": "s13",
      "chapter": "chuong-2",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b027",
          "text": "Bước hai: mỗi lớp được cắt thành những ô vuông nhỏ 8×8, tức 64 điểm.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": [
            "c010"
          ]
        },
        {
          "id": "b028",
          "text": "Mỗi ô được ghi lại bằng một phép toán tên là phép biến đổi cosin rời rạc.",
          "spoken": null,
          "cue": null,
          "pause_ms": 500,
          "sfx": null,
          "claims": [
            "c010"
          ]
        }
      ]
    },
    {
      "id": "s14",
      "chapter": "chuong-2",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b029",
          "text": "Hãy hình dung một bộ khuôn hoa văn có sẵn: khuôn trơn, khuôn sọc to, khuôn sọc li ti.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": []
        },
        {
          "id": "b030",
          "text": "Thay vì nhớ 64 điểm, máy nhớ mỗi loại khuôn cần đậm hay nhạt bao nhiêu, rồi chồng chúng lên nhau.",
          "spoken": null,
          "cue": null,
          "pause_ms": 450,
          "sfx": null,
          "claims": [
            "c010"
          ]
        },
        {
          "id": "b031",
          "text": "Con số đầu tiên ứng với khuôn trơn, đại diện cho độ sáng trung bình của cả ô.",
          "spoken": null,
          "cue": null,
          "pause_ms": 500,
          "sfx": null,
          "claims": [
            "c010"
          ]
        }
      ]
    },
    {
      "id": "s15",
      "chapter": "chuong-2",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b032",
          "text": "Một ô trời xanh trơn thì gần như chỉ cần khuôn trơn. Con số của các khuôn sọc gần bằng không.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": []
        },
        {
          "id": "b033",
          "text": "Còn một ô có viền chữ sắc nét thì cần rất nhiều khuôn sọc li ti.",
          "spoken": null,
          "cue": null,
          "pause_ms": 500,
          "sfx": null,
          "claims": []
        }
      ]
    },
    {
      "id": "s16",
      "chapter": "chuong-2",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b034",
          "text": "Bước này gần như chưa mất gì. Nhưng nó gom chi tiết li ti vào những con số riêng, để bước ba dễ vứt.",
          "spoken": null,
          "cue": null,
          "pause_ms": 900,
          "sfx": null,
          "claims": []
        }
      ]
    },
    {
      "id": "s17",
      "chapter": "chuong-3",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b035",
          "text": "Bước ba mới là chỗ ảnh thật sự mất dữ liệu: lượng tử hoá, nói nôm na là làm tròn thô.",
          "spoken": null,
          "cue": null,
          "pause_ms": 500,
          "sfx": null,
          "claims": [
            "c012"
          ]
        }
      ]
    },
    {
      "id": "s18",
      "chapter": "chuong-3",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b036",
          "text": "Hãy nghĩ tới giá tiền: mười hai nghìn tư, mười hai nghìn ba, mười một nghìn sáu.",
          "spoken": null,
          "cue": null,
          "pause_ms": 350,
          "sfx": null,
          "claims": []
        },
        {
          "id": "b037",
          "text": "Làm tròn tới nghìn, cả ba đều thành mười hai nghìn. Ở đây, một nghìn chính là mức làm tròn.",
          "spoken": null,
          "cue": null,
          "pause_ms": 450,
          "sfx": null,
          "claims": []
        },
        {
          "id": "b038",
          "text": "Chỉ biết mười hai nghìn, bạn không đoán lại được giá gốc. Phần lẻ đã mất hẳn.",
          "spoken": null,
          "cue": null,
          "pause_ms": 500,
          "sfx": null,
          "claims": []
        }
      ]
    },
    {
      "id": "s19",
      "chapter": "chuong-3",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b039",
          "text": "JPEG làm đúng như vậy: chia mỗi con số trong ô cho một mức làm tròn, từ 1 đến 255, rồi làm tròn.",
          "spoken": null,
          "cue": null,
          "pause_ms": 450,
          "sfx": null,
          "claims": [
            "c012"
          ]
        },
        {
          "id": "b040",
          "text": "Nhiều giá trị khác nhau bị dồn về cùng một số. Đó là nguồn mất dữ liệu chính của JPEG.",
          "spoken": null,
          "cue": null,
          "pause_ms": 500,
          "sfx": null,
          "claims": [
            "c012"
          ]
        }
      ]
    },
    {
      "id": "s20",
      "chapter": "chuong-3",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b041",
          "text": "Con số của các khuôn sọc li ti thường gặp mức làm tròn lớn, nên bị làm tròn về không và biến mất.",
          "spoken": null,
          "cue": null,
          "pause_ms": 450,
          "sfx": null,
          "claims": [
            "c012",
            "c010"
          ]
        },
        {
          "id": "b042",
          "text": "Vì vậy ảnh nén mạnh mất nét, mảng trời nổi lên từng ô vuông: mỗi ô còn lại quá ít hoa văn.",
          "spoken": null,
          "cue": null,
          "pause_ms": 800,
          "sfx": null,
          "claims": []
        }
      ]
    },
    {
      "id": "s21",
      "chapter": "chuong-3",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b043",
          "text": "Lưu ảnh JPEG ở chất lượng 100, mức cao nhất của thang, ảnh vẫn mất dữ liệu.",
          "spoken": null,
          "cue": null,
          "pause_ms": 500,
          "sfx": null,
          "claims": [
            "c016",
            "c014"
          ]
        },
        {
          "id": "b044",
          "text": "Vì JPEG vứt dữ liệu ở hai chỗ.",
          "spoken": null,
          "cue": null,
          "pause_ms": 300,
          "sfx": null,
          "claims": []
        },
        {
          "id": "b045",
          "text": "Một là bớt chi tiết phần màu, vì mắt người kém nhạy với màu hơn với độ sáng.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": [
            "c016",
            "c008"
          ]
        },
        {
          "id": "b046",
          "text": "Hai là làm tròn những con số mô tả ảnh, giống như làm tròn giá tiền.",
          "spoken": null,
          "cue": null,
          "pause_ms": 450,
          "sfx": null,
          "claims": [
            "c016",
            "c012"
          ]
        }
      ]
    },
    {
      "id": "s22",
      "chapter": "chuong-3",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b047",
          "text": "Ở mức 100, phần làm tròn giảm tới mức ít nhất. Nhưng phần màu vẫn bị bớt, và vẫn còn làm tròn.",
          "spoken": null,
          "cue": null,
          "pause_ms": 500,
          "sfx": null,
          "claims": [
            "c016"
          ]
        }
      ]
    },
    {
      "id": "s23",
      "chapter": "chuong-3",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b048",
          "text": "Mà đẩy chất lượng lên thật cao cũng chẳng đáng.",
          "spoken": null,
          "cue": null,
          "pause_ms": 300,
          "sfx": null,
          "claims": []
        },
        {
          "id": "b049",
          "text": "Thư viện nén ảnh libjpeg-turbo đặt mặc định là 75, và khuyên dùng từ 50 đến 95 cho ảnh chụp.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": [
            "c015"
          ]
        },
        {
          "id": "b050",
          "text": "Đặt trên khoảng 95 thì tệp to lên rất nhiều, mà mắt người hiếm khi thấy khác.",
          "spoken": null,
          "cue": null,
          "pause_ms": 450,
          "sfx": null,
          "claims": [
            "c015"
          ]
        },
        {
          "id": "b051",
          "text": "Nên lưu JPEG ở mức 100 không có nghĩa là giữ nguyên ảnh gốc.",
          "spoken": null,
          "cue": null,
          "pause_ms": 800,
          "sfx": null,
          "claims": [
            "c016"
          ]
        }
      ]
    },
    {
      "id": "s24",
      "chapter": "chuong-3",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b052",
          "text": "Phép toán nằm ở lõi của ảnh JPEG từng bị chê là quá đơn giản.",
          "spoken": null,
          "cue": null,
          "pause_ms": 450,
          "sfx": null,
          "claims": [
            "c011",
            "c006"
          ]
        },
        {
          "id": "b053",
          "text": "Năm 1972, nhà nghiên cứu Nasir Ahmed xin Quỹ Khoa học Quốc gia Mỹ tài trợ để nghiên cứu nó.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": [
            "c011"
          ]
        },
        {
          "id": "b054",
          "text": "Ông bị từ chối. Những người thẩm định cho rằng ý tưởng ấy quá đơn giản.",
          "spoken": null,
          "cue": null,
          "pause_ms": 500,
          "sfx": null,
          "claims": [
            "c011"
          ]
        }
      ]
    },
    {
      "id": "s25",
      "chapter": "chuong-3",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b055",
          "text": "Ông vẫn làm tiếp, và tháng 1/1974 cùng hai đồng nghiệp công bố phép biến đổi cosin rời rạc.",
          "spoken": "Ông vẫn làm tiếp, và tháng một năm một nghìn chín trăm bảy mươi tư cùng hai đồng nghiệp công bố phép biến đổi cô sin rời rạc.",
          "cue": null,
          "pause_ms": 500,
          "sfx": null,
          "claims": [
            "c011"
          ]
        }
      ]
    },
    {
      "id": "s26",
      "chapter": "chuong-3",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b056",
          "text": "Hơn chục năm sau, nhóm chuyên gia làm chuẩn JPEG cho các cách nén ảnh thi với nhau, chấm mù.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": [
            "c006"
          ]
        },
        {
          "id": "b057",
          "text": "Cách dựa trên phép biến đổi cosin cho chất lượng ảnh tốt nhất, và thành lõi của JPEG.",
          "spoken": null,
          "cue": null,
          "pause_ms": 500,
          "sfx": null,
          "claims": [
            "c006"
          ]
        },
        {
          "id": "b058",
          "text": "Ý tưởng từng bị chê quá đơn giản ấy, nay nằm trong gần như mọi tấm ảnh JPEG.",
          "spoken": null,
          "cue": null,
          "pause_ms": 800,
          "sfx": null,
          "claims": [
            "c011",
            "c006"
          ]
        }
      ]
    },
    {
      "id": "s27",
      "chapter": "chuong-3",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b059",
          "text": "JPEG cũng có sở trường và sở đoản.",
          "spoken": null,
          "cue": null,
          "pause_ms": 300,
          "sfx": null,
          "claims": [
            "c017"
          ]
        },
        {
          "id": "b060",
          "text": "Nó nén tốt ảnh chụp có màu và độ sáng chuyển dần.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": [
            "c017"
          ]
        },
        {
          "id": "b061",
          "text": "Nhưng nét mảnh, cạnh sắc thì nén không tốt và dễ lộ vết nén. Điều này sẽ quay lại ở cuối tập.",
          "spoken": null,
          "cue": null,
          "pause_ms": 900,
          "sfx": null,
          "claims": [
            "c017"
          ]
        }
      ]
    },
    {
      "id": "s28",
      "chapter": "chuong-4",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b062",
          "text": "Giờ tới câu hỏi thứ hai: vì sao vứt một lần không ai thấy, mà vứt nhiều lần thì ảnh mờ dần?",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": []
        },
        {
          "id": "b063",
          "text": "Hiện tượng này gọi là mất thế hệ, giống bản sao chụp của một bản sao chụp.",
          "spoken": null,
          "cue": null,
          "pause_ms": 500,
          "sfx": null,
          "claims": []
        }
      ]
    },
    {
      "id": "s29",
      "chapter": "chuong-4",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b064",
          "text": "Thư viện libjpeg-turbo khuyên tránh cho một ảnh đi qua nhiều vòng nén rồi giải nén.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": [
            "c002"
          ]
        },
        {
          "id": "b065",
          "text": "Vì chất lượng mất đi sẽ cộng dồn. Sau chừng mười vòng, ảnh có thể xấu đi thấy rõ.",
          "spoken": null,
          "cue": null,
          "pause_ms": 600,
          "sfx": null,
          "claims": [
            "c002"
          ]
        }
      ]
    },
    {
      "id": "s30",
      "chapter": "chuong-4",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b066",
          "text": "Nhưng có một chi tiết ít người biết.",
          "spoken": null,
          "cue": null,
          "pause_ms": 300,
          "sfx": null,
          "claims": []
        },
        {
          "id": "b067",
          "text": "Nén lại một ảnh JPEG với đúng cài đặt cũ thì ảnh thường gần như không đổi thêm.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": [
            "c018"
          ]
        },
        {
          "id": "b068",
          "text": "Một thí nghiệm năm 2025 đo thấy như vậy, nhất là khi ảnh đã bị nén mạnh.",
          "spoken": null,
          "cue": null,
          "pause_ms": 450,
          "sfx": null,
          "claims": [
            "c018"
          ]
        }
      ]
    },
    {
      "id": "s31",
      "chapter": "chuong-4",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b069",
          "text": "Lý do giống ví dụ giá tiền: mười hai nghìn đem làm tròn tới nghìn lần nữa, vẫn là mười hai nghìn.",
          "spoken": null,
          "cue": null,
          "pause_ms": 600,
          "sfx": null,
          "claims": []
        }
      ]
    },
    {
      "id": "s32",
      "chapter": "chuong-4",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b070",
          "text": "Hãy theo một tấm ảnh: chụp xong, gửi vào nhóm, có người lưu về, cắt bớt, rồi gửi sang ứng dụng khác.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": []
        },
        {
          "id": "b071",
          "text": "Mỗi chặng, ảnh bị mở ra rồi lưu lại, mà mỗi nơi lưu theo một cách riêng.",
          "spoken": null,
          "cue": null,
          "pause_ms": 500,
          "sfx": null,
          "claims": []
        }
      ]
    },
    {
      "id": "s33",
      "chapter": "chuong-4",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b072",
          "text": "Vậy cái gì làm ảnh xấu dần? Có ba thứ.",
          "spoken": null,
          "cue": null,
          "pause_ms": 500,
          "sfx": null,
          "claims": []
        }
      ]
    },
    {
      "id": "s34",
      "chapter": "chuong-4",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b073",
          "text": "Thứ nhất: nơi khác nén lại với mức làm tròn khác. Các con số lại bị làm tròn theo một kiểu mới.",
          "spoken": null,
          "cue": null,
          "pause_ms": 500,
          "sfx": null,
          "claims": [
            "c019"
          ]
        }
      ]
    },
    {
      "id": "s35",
      "chapter": "chuong-4",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b074",
          "text": "Thứ hai: lưới ô 8×8 của lần nén sau có thể lệch so với lưới lần trước.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": [
            "c019"
          ]
        },
        {
          "id": "b075",
          "text": "Ảnh bị cắt hay thêm viền thì các ô bị chia lại theo lưới mới, và lần lưu mới phải làm tròn tiếp.",
          "spoken": null,
          "cue": null,
          "pause_ms": 500,
          "sfx": null,
          "claims": []
        }
      ]
    },
    {
      "id": "s36",
      "chapter": "chuong-4",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b076",
          "text": "Dấu vết các lần nén chồng lên nhau rõ tới mức nhà pháp chứng ảnh dựa được vào đó.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": [
            "c019"
          ]
        },
        {
          "id": "b077",
          "text": "Đó là những người chuyên soi ảnh bị sửa. Nhìn dấu vết ấy, họ biết một tấm ảnh đã bị nén hai lần.",
          "spoken": null,
          "cue": null,
          "pause_ms": 500,
          "sfx": null,
          "claims": [
            "c019"
          ]
        }
      ]
    },
    {
      "id": "s37",
      "chapter": "chuong-4",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b078",
          "text": "Thứ ba: thu nhỏ ảnh. Mỗi lần thu nhỏ là mất hẳn một phần điểm ảnh.",
          "spoken": null,
          "cue": null,
          "pause_ms": 600,
          "sfx": null,
          "claims": []
        }
      ]
    },
    {
      "id": "s38",
      "chapter": "chuong-4",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b079",
          "text": "Ba thứ này cùng xảy ra khi ảnh đi qua nhiều ứng dụng khác nhau, mỗi nơi một luật.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": []
        },
        {
          "id": "b080",
          "text": "Nên ảnh không mờ vì bị gửi nhiều. Ảnh mờ vì bị nhiều nơi nén lại, mỗi nơi một kiểu.",
          "spoken": null,
          "cue": null,
          "pause_ms": 900,
          "sfx": null,
          "claims": []
        }
      ]
    },
    {
      "id": "s39",
      "chapter": "chuong-5",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b081",
          "text": "Vậy các ứng dụng làm gì với ảnh của bạn? Họ nói khá thẳng.",
          "spoken": null,
          "cue": null,
          "pause_ms": 600,
          "sfx": null,
          "claims": []
        }
      ]
    },
    {
      "id": "s40",
      "chapter": "chuong-5",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b082",
          "text": "Ảnh bạn nhận qua ứng dụng chat thường không phải ảnh gốc. Chính các ứng dụng nói vậy.",
          "spoken": null,
          "cue": null,
          "pause_ms": 500,
          "sfx": null,
          "claims": [
            "c001",
            "c020"
          ]
        }
      ]
    },
    {
      "id": "s41",
      "chapter": "chuong-5",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b083",
          "text": "Trang hỏi đáp của Telegram ghi: Telegram làm ảnh nhỏ đi trước khi gửi.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": [
            "c001"
          ]
        },
        {
          "id": "b084",
          "text": "Để ảnh tải ngay và tốn ít dữ liệu di động.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": [
            "c001"
          ]
        },
        {
          "id": "b085",
          "text": "Ngay cả chế độ High Definition của Telegram cũng giữ ảnh dưới 0,5 MB.",
          "spoken": "Ngay cả chế độ nét cao của Telegram cũng giữ ảnh dưới không phẩy năm mê-ga-bai.",
          "cue": null,
          "pause_ms": 500,
          "sfx": null,
          "claims": [
            "c001"
          ]
        }
      ]
    },
    {
      "id": "s42",
      "chapter": "chuong-5",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b086",
          "text": "Trang trợ giúp của Instagram ghi: ảnh rộng hơn 1.080 điểm bị giảm xuống còn 1.080.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": [
            "c023"
          ]
        },
        {
          "id": "b087",
          "text": "Ví dụ, ảnh rộng 4.000 điểm thì số điểm ảnh chỉ còn khoảng 7%.",
          "spoken": null,
          "cue": null,
          "pause_ms": 500,
          "sfx": null,
          "claims": [
            "c023"
          ]
        }
      ]
    },
    {
      "id": "s43",
      "chapter": "chuong-5",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b088",
          "text": "WhatsApp cho chọn gửi ảnh chất lượng thường hoặc HD.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": [
            "c024"
          ]
        },
        {
          "id": "b089",
          "text": "WhatsApp còn ghi: kể cả khi gửi HD, đường truyền mạng vẫn ảnh hưởng tới chất lượng ảnh.",
          "spoken": null,
