          "pause_ms": 400,
          "sfx": null,
          "claims": [
            "c014"
          ]
        },
        {
          "id": "b056",
          "text": "Thư viện nén ảnh libjpeg tự gọi cách của mình là đường co giãn khuyến nghị của chúng tôi.",
