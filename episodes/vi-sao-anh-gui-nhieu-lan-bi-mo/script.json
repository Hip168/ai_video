  "scenes": [
    {
      "id": "s01",
      "chapter": "mo-dau",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b001",
          "text": "Bức ảnh bạn vừa nhận qua ứng dụng chat rất có thể không còn là bức ảnh người ta đã chụp.",
          "spoken": null,
          "cue": null,
          "pause_ms": 600,
          "sfx": null,
          "claims": [
            "c001",
            "c020"
          ]
        }
      ]
    },
    {
      "id": "s02",
      "chapter": "mo-dau",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b002",
          "text": "Chính Telegram viết trong trang hỏi đáp của họ: Telegram làm ảnh nhỏ đi trước khi gửi.",
          "spoken": null,
          "cue": null,
          "pause_ms": 600,
          "sfx": null,
          "claims": [
            "c001"
          ]
        }
      ]
    },
    {
      "id": "s03",
      "chapter": "mo-dau",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b003",
          "text": "Còn tài liệu của libjpeg-turbo, một bộ thư viện nén ảnh JPEG, cảnh báo thêm một điều.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": [
            "c002"
          ]
        },
        {
          "id": "b004",
          "text": "Nén đi nén lại chừng mười vòng, ảnh có thể xấu đi thấy rõ.",
          "spoken": null,
          "cue": null,
          "pause_ms": 700,
          "sfx": null,
          "claims": [
            "c002"
          ]
        }
      ]
    },
    {
      "id": "s04",
      "chapter": "mo-dau",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b005",
          "text": "Vậy mỗi lần gửi, thứ gì trong ảnh bị vứt đi?",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": []
        },
        {
          "id": "b006",
          "text": "Vì sao vứt một lần thì không ai thấy, mà vứt nhiều lần thì ai cũng thấy?",
          "spoken": null,
          "cue": null,
          "pause_ms": 500,
          "sfx": null,
          "claims": []
        },
        {
          "id": "b007",
          "text": "Và có cách nào gửi ảnh mà không mất gì không? Có, và câu trả lời nằm ở cuối tập.",
          "spoken": null,
          "cue": null,
          "pause_ms": 700,
          "sfx": null,
          "claims": []
        }
      ]
    },
    {
      "id": "s05",
      "chapter": "mo-dau",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b008",
          "text": "Muốn hiểu, hãy xem một tấm ảnh thật ra là gì, và một chuẩn nén ra đời năm 1992 làm gì với nó.",
          "spoken": null,
          "cue": null,
          "pause_ms": 900,
          "sfx": null,
          "claims": [
            "c005",
            "c004"
          ]
        }
      ]
    },
    {
      "id": "s06",
      "chapter": "chuong-1",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b009",
          "text": "Với máy tính, một tấm ảnh chỉ là một lưới điểm, và mỗi điểm là vài con số.",
          "spoken": null,
          "cue": null,
          "pause_ms": 450,
          "sfx": null,
          "claims": []
        }
      ]
    },
    {
      "id": "s07",
      "chapter": "chuong-1",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b010",
          "text": "Một ảnh màu thông thường lưu mỗi điểm bằng 3 thành phần màu, mỗi thành phần 8 bit.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": [
            "c003"
          ]
        },
        {
          "id": "b011",
          "text": "Tức 24 bit cho một điểm ảnh, khi chưa nén.",
          "spoken": null,
          "cue": null,
          "pause_ms": 450,
          "sfx": null,
          "claims": [
            "c003"
          ]
        }
      ]
    },
    {
      "id": "s08",
      "chapter": "chuong-1",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b012",
          "text": "Làm phép tính: một ảnh 12 triệu điểm sẽ cần khoảng 36 MB.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": [
            "c003"
          ]
        },
        {
          "id": "b013",
          "text": "Gửi nguyên như thế qua mạng thì vừa chậm, vừa tốn dữ liệu di động.",
          "spoken": null,
          "cue": null,
          "pause_ms": 600,
          "sfx": null,
          "claims": []
        }
      ]
    },
    {
      "id": "s09",
      "chapter": "chuong-1",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b014",
          "text": "Nên người ta nén ảnh. Và có một kiểu nén chịu vứt bớt dữ liệu, nhưng vứt có chọn lọc.",
          "spoken": null,
          "cue": null,
          "pause_ms": 500,
          "sfx": null,
          "claims": []
        }
      ]
    },
    {
      "id": "s10",
      "chapter": "chuong-1",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b015",
          "text": "Năm 1992, kỹ sư Gregory Wallace viết một bài tổng quan về chuẩn nén ảnh JPEG.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": [
            "c004"
          ]
        },
        {
          "id": "b016",
          "text": "Theo bài này, nén còn 1,5 đến 2 bit mỗi điểm thì ảnh thường không phân biệt được với ảnh gốc.",
          "spoken": null,
          "cue": null,
          "pause_ms": 450,
          "sfx": null,
          "claims": [
            "c004"
          ]
        },
        {
          "id": "b017",
          "text": "So với 24 bit lúc đầu, làm phép tính thì ảnh nhỏ đi khoảng 12 đến 16 lần, mà mắt không nhận ra.",
          "spoken": null,
          "cue": null,
          "pause_ms": 600,
          "sfx": null,
          "claims": [
            "c004"
          ]
        }
      ]
    },
    {
      "id": "s11",
      "chapter": "chuong-1",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b018",
          "text": "Chuẩn JPEG ấy được xây dựng từ năm 1986, và bản chuẩn đầu tiên ra đời tháng 9/1992.",
          "spoken": "Chuẩn JPEG ấy được xây dựng từ năm một nghìn chín trăm tám mươi sáu, và bản chuẩn đầu tiên ra đời tháng chín năm một nghìn chín trăm chín mươi hai.",
          "cue": null,
          "pause_ms": 450,
          "sfx": null,
          "claims": [
            "c005"
          ]
        },
        {
          "id": "b019",
          "text": "Tên JPEG là viết tắt tên một nhóm chuyên gia về ảnh, lập ra từ sự hợp tác giữa CCITT và ISO.",
          "spoken": "Tên JPEG là viết tắt tên một nhóm chuyên gia về ảnh, lập ra từ sự hợp tác giữa hai tổ chức làm chuẩn.",
          "cue": null,
          "pause_ms": 450,
          "sfx": null,
          "claims": [
            "c006"
          ]
        }
      ]
    },
    {
      "id": "s12",
      "chapter": "chuong-1",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b020",
          "text": "Tới nay, chính ủy ban JPEG gọi nó là định dạng ảnh tĩnh thống trị nhất.",
          "spoken": null,
          "cue": null,
          "pause_ms": 600,
          "sfx": null,
          "claims": [
            "c007"
          ]
        }
      ]
    },
    {
      "id": "s13",
      "chapter": "chuong-1",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b021",
          "text": "Nhưng muốn nhỏ đi cả chục lần mà mắt không thấy, JPEG phải vứt đi rất nhiều. Vứt gì, và vứt thế nào?",
          "spoken": null,
          "cue": null,
          "pause_ms": 500,
          "sfx": null,
          "claims": [
            "c004"
          ]
        }
      ]
    },
    {
      "id": "s14",
      "chapter": "chuong-1",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b022",
          "text": "JPEG làm việc đó qua ba bước: bớt màu, ghi lại từng ô nhỏ theo cách khác, rồi làm tròn thô.",
          "spoken": null,
          "cue": null,
          "pause_ms": 900,
          "sfx": null,
          "claims": [
            "c009",
            "c010",
            "c012"
          ]
        }
      ]
    },
    {
      "id": "s15",
      "chapter": "chuong-2",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b023",
          "text": "Bước một dựa vào một điểm yếu của mắt người.",
          "spoken": null,
          "cue": null,
          "pause_ms": 300,
          "sfx": null,
          "claims": []
        },
        {
          "id": "b024",
          "text": "Mắt người nhạy với thay đổi về độ sáng hơn là thay đổi về màu.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": [
            "c008"
          ]
        },
        {
          "id": "b025",
          "text": "Nên phần màu có thể bị bớt chi tiết nhiều hơn, mà ta không thấy ảnh kém đi.",
          "spoken": null,
          "cue": null,
          "pause_ms": 500,
          "sfx": null,
          "claims": [
            "c008"
          ]
        }
      ]
    },
    {
      "id": "s16",
      "chapter": "chuong-2",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b026",
          "text": "Khi nén, JPEG thường tách ảnh thành một kênh độ sáng và hai kênh màu.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": [
            "c009"
          ]
        },
        {
          "id": "b027",
          "text": "Trong thư viện libjpeg, mặc định mỗi kênh màu chỉ giữ một nửa chiều ngang và một nửa chiều dọc.",
          "spoken": null,
          "cue": null,
          "pause_ms": 450,
          "sfx": null,
          "claims": [
            "c009"
          ]
        },
        {
          "id": "b028",
          "text": "Làm phép tính: phần màu chỉ còn một phần tư số điểm. Kiểu này hay được ghi là 4:2:0.",
          "spoken": "Làm phép tính: phần màu chỉ còn một phần tư số điểm. Kiểu này hay được ghi là bốn hai không.",
          "cue": null,
          "pause_ms": 500,
          "sfx": null,
          "claims": [
            "c009"
          ]
        }
      ]
    },
    {
      "id": "s17",
      "chapter": "chuong-2",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b029",
          "text": "Hình dung một ảnh đen trắng thật nét, phủ lên một lớp màu hơi nhoè. Mắt vẫn thấy như ảnh thật.",
          "spoken": null,
          "cue": null,
          "pause_ms": 600,
          "sfx": null,
          "claims": []
        }
      ]
    },
    {
      "id": "s18",
      "chapter": "chuong-2",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b030",
          "text": "Bước hai: mỗi kênh được cắt thành những ô vuông 8×8, tức 64 điểm.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": [
            "c010"
          ]
        },
        {
          "id": "b031",
          "text": "Rồi mỗi ô được ghi lại theo cách khác, bằng phép biến đổi cosin rời rạc.",
          "spoken": null,
          "cue": null,
          "pause_ms": 450,
          "sfx": null,
          "claims": [
            "c010"
          ]
        }
      ]
    },
    {
      "id": "s19",
      "chapter": "chuong-2",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b032",
          "text": "Thay vì nhớ 64 con số rời, máy nhớ cách pha trộn một bộ hoa văn sọc có sẵn.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": [
            "c010"
          ]
        },
        {
          "id": "b033",
          "text": "Số đầu tiên đại diện cho độ sáng trung bình của cả ô.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": [
            "c010"
          ]
        },
        {
          "id": "b034",
          "text": "Các số sau cho biết cần thêm bao nhiêu sọc to, bao nhiêu sọc li ti.",
          "spoken": null,
          "cue": null,
          "pause_ms": 450,
          "sfx": null,
          "claims": []
        }
      ]
    },
    {
      "id": "s20",
      "chapter": "chuong-2",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b035",
          "text": "Đổi cách ghi như vậy gần như chưa mất gì. Nhưng nó tách riêng chi tiết li ti, để bước sau dễ vứt.",
          "spoken": null,
          "cue": null,
          "pause_ms": 800,
          "sfx": null,
          "claims": []
        }
      ]
    },
    {
      "id": "s21",
      "chapter": "chuong-2",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b036",
          "text": "Phép toán nằm ở lõi của ảnh JPEG từng bị chê là quá đơn giản.",
          "spoken": null,
          "cue": null,
          "pause_ms": 500,
          "sfx": null,
          "claims": [
            "c011",
            "c006"
          ]
        },
        {
          "id": "b037",
          "text": "Năm 1972, Nasir Ahmed xin Quỹ Khoa học Quốc gia Mỹ tài trợ để nghiên cứu phép biến đổi cosin.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": [
            "c011"
          ]
        },
        {
          "id": "b038",
          "text": "Ông bị từ chối. Những người thẩm định cho rằng ý tưởng ấy quá đơn giản.",
          "spoken": null,
          "cue": null,
          "pause_ms": 500,
          "sfx": null,
          "claims": [
            "c011"
          ]
        }
      ]
    },
    {
      "id": "s22",
      "chapter": "chuong-2",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b039",
          "text": "Tháng 1/1974, ông cùng Natarajan và Rao đăng bài về phép biến đổi cosin rời rạc.",
          "spoken": "Tháng một năm một nghìn chín trăm bảy mươi tư, ông cùng Natarajan và Rao đăng bài về phép biến đổi cô sin rời rạc.",
          "cue": null,
          "pause_ms": 500,
          "sfx": null,
          "claims": [
            "c011"
          ]
        }
      ]
    },
    {
      "id": "s23",
      "chapter": "chuong-2",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b040",
          "text": "Tháng 6/1987, nhóm chuyên gia JPEG chấm mù 12 cách nén ảnh, giữ lại 3.",
          "spoken": "Tháng sáu năm một nghìn chín trăm tám mươi bảy, nhóm chuyên gia JPEG chấm mù mười hai cách nén ảnh, giữ lại ba.",
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": [
            "c006"
          ]
        },
        {
          "id": "b041",
          "text": "Tháng 1/1988, cách dựa trên phép biến đổi cosin, chia ảnh thành ô 8×8, cho chất lượng tốt nhất.",
          "spoken": "Tháng một năm một nghìn chín trăm tám mươi tám, cách dựa trên phép biến đổi cô sin, chia ảnh thành ô tám nhân tám, cho chất lượng tốt nhất.",
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": [
            "c006"
          ]
        },
        {
          "id": "b042",
          "text": "Rồi nó thành lõi của chuẩn JPEG ra đời tháng 9/1992.",
          "spoken": "Rồi nó thành lõi của chuẩn JPEG ra đời tháng chín năm một nghìn chín trăm chín mươi hai.",
          "cue": null,
          "pause_ms": 500,
          "sfx": null,
          "claims": [
            "c005"
          ]
        }
      ]
    },
    {
      "id": "s24",
      "chapter": "chuong-2",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b043",
          "text": "Ý tưởng từng bị chê quá đơn giản ấy, nay nằm trong gần như mọi tấm ảnh JPEG.",
          "spoken": null,
          "cue": null,
