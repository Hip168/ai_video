      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b111",
          "text": "Nhưng định dạng nào cũng vậy: ảnh cứ bị nén lại kiểu mất dữ liệu thì vẫn mất thế hệ.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": []
        },
        {
          "id": "b112",
          "text": "Thứ giữ được ảnh không phải định dạng, mà là đừng để ảnh bị nén lại.",
          "spoken": null,
          "cue": null,
          "pause_ms": 900,
          "sfx": null,
          "claims": []
        }
      ]
    },
    {
      "id": "s51",
      "chapter": "ket",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b113",
          "text": "Vậy gửi thế nào để người nhận có đúng ảnh gốc? Ba mẹo.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": []
        },
        {
          "id": "b114",
          "text": "Một: cần giữ ảnh gốc thì gửi dạng tệp. Telegram ghi rõ, gửi dạng tệp thì không nén chút nào.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": [
            "c001"
          ]
        },
        {
          "id": "b115",
          "text": "Hai: giữ bản gốc trong máy. Đừng lưu ảnh nhận được rồi gửi tiếp.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": []
        },
        {
          "id": "b116",
          "text": "Ba: đừng chụp màn hình một tấm ảnh để gửi lại.",
          "spoken": null,
          "cue": null,
          "pause_ms": 700,
          "sfx": null,
          "claims": []
        }
      ]
    },
    {
      "id": "s52",
