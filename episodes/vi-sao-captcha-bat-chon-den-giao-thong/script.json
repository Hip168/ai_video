  "scenes": [
    {
      "id": "s01",
      "chapter": "mo-dau",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b001",
          "text": "Loài người đã bỏ ra khoảng 819 triệu giờ chỉ để chứng minh mình không phải người máy.",
          "spoken": null,
          "cue": null,
          "pause_ms": 500,
          "sfx": null,
          "claims": [
            "c001"
          ]
        },
        {
          "id": "b002",
          "text": "Đó là ước tính của một nhóm nghiên cứu ở Đại học California Irvine, cho các ô reCAPTCHA.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": [
            "c001"
          ]
        }
      ]
    },
    {
      "id": "s02",
      "chapter": "mo-dau",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b003",
          "text": "Đổi ra năm, 819 triệu giờ là khoảng 93 nghìn năm.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": [
            "c002",
            "c001"
          ]
        },
        {
          "id": "b004",
          "text": "Tức là gõ chữ méo, chọn đèn giao thông, chọn vạch qua đường.",
          "spoken": null,
          "cue": null,
          "pause_ms": 500,
          "sfx": null,
          "claims": [
            "c001"
          ]
        }
      ]
    },
    {
      "id": "s03",
      "chapter": "mo-dau",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b005",
          "text": "Và nếu trả công, số giờ ấy đáng ít nhất 6,1 tỉ đô la Mỹ.",
          "spoken": null,
          "cue": null,
          "pause_ms": 600,
          "sfx": null,
          "claims": [
            "c001"
          ]
        }
      ]
    },
    {
      "id": "s04",
      "chapter": "mo-dau",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b006",
          "text": "Mà công sức đó không mất đi. Theo Google, nó được dùng để gắn nhãn ảnh và xây dữ liệu cho máy học.",
          "spoken": null,
          "cue": null,
          "pause_ms": 700,
          "sfx": null,
          "claims": [
            "c023"
          ]
        }
      ]
    },
    {
      "id": "s05",
      "chapter": "mo-dau",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b007",
          "text": "Vậy vì sao cứ phải là đèn giao thông?",
          "spoken": null,
          "cue": null,
          "pause_ms": 300,
          "sfx": null,
          "claims": []
        },
        {
          "id": "b008",
          "text": "Vì sao có người bấm một lần là qua, có người bị hỏi mãi?",
          "spoken": null,
          "cue": null,
          "pause_ms": 300,
          "sfx": null,
          "claims": []
        },
        {
          "id": "b009",
          "text": "Và máy có thật sự thua người ở bài thi này không?",
          "spoken": null,
          "cue": null,
          "pause_ms": 900,
          "sfx": null,
          "claims": []
        }
      ]
    },
    {
      "id": "s06",
      "chapter": "chuong-1",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b010",
          "text": "Câu chuyện bắt đầu bằng một cuộc bình chọn bị người máy phá.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": []
        }
      ]
    },
    {
      "id": "s07",
      "chapter": "chuong-1",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b011",
          "text": "Tháng 11/1999, trang tin công nghệ Slashdot mở bình chọn trường cao học khoa học máy tính tốt nhất.",
          "spoken": "Tháng mười một năm một nghìn chín trăm chín mươi chín, trang tin công nghệ Slashdot mở bình chọn trường cao học khoa học máy tính tốt nhất.",
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": [
            "c006"
          ]
        },
        {
          "id": "b012",
          "text": "Sinh viên Carnegie Mellon viết một chương trình tự động bỏ phiếu liên tục.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": [
            "c006"
          ]
        },
        {
          "id": "b013",
          "text": "Sinh viên MIT thấy vậy, liền viết chương trình đáp trả.",
          "spoken": null,
          "cue": null,
          "pause_ms": 500,
          "sfx": null,
          "claims": [
            "c006"
          ]
        }
      ]
    },
    {
      "id": "s08",
      "chapter": "chuong-1",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b014",
          "text": "Kết quả: MIT về nhất với 21.156 phiếu, Carnegie Mellon 21.032 phiếu.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": [
            "c006"
          ]
        },
        {
          "id": "b015",
          "text": "Mọi trường khác đều dưới 1.000 phiếu. Cuộc bình chọn thành cuộc đấu của hai người máy.",
          "spoken": null,
          "cue": null,
          "pause_ms": 600,
          "sfx": null,
          "claims": [
            "c006"
          ]
        }
      ]
    },
    {
      "id": "s09",
      "chapter": "chuong-1",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b016",
          "text": "Chuyện không dừng ở bình chọn.",
          "spoken": null,
          "cue": null,
          "pause_ms": 300,
          "sfx": null,
          "claims": []
        },
        {
          "id": "b017",
          "text": "Các dịch vụ thư điện tử miễn phí bị chương trình tự động đăng ký hàng nghìn tài khoản mỗi phút.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": [
            "c007"
          ]
        },
        {
          "id": "b018",
          "text": "Những tài khoản ấy dùng để rải thư rác, và chủ dịch vụ cần một cách chặn chúng.",
          "spoken": null,
          "cue": null,
          "pause_ms": 500,
          "sfx": null,
          "claims": []
        }
      ]
    },
    {
      "id": "s10",
      "chapter": "chuong-1",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b019",
          "text": "Ví dụ thực tế đầu tiên là hệ thống của AltaVista, một công cụ tìm kiếm thời đó.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": [
            "c008"
          ]
        },
        {
          "id": "b020",
          "text": "Nó bắt người đăng ký đọc vài ký tự bị méo nhẹ, thứ mà máy thời ấy đọc không ra.",
          "spoken": null,
          "cue": null,
          "pause_ms": 500,
          "sfx": null,
          "claims": [
            "c008"
          ]
        }
      ]
    },
    {
      "id": "s11",
      "chapter": "chuong-1",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b021",
          "text": "Năm 2000, một nhóm ở Đại học Carnegie Mellon đặt tên cho ý tưởng này: CAPTCHA.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": [
            "c008",
            "c010"
          ]
        },
        {
          "id": "b022",
          "text": "Nhóm do Luis von Ahn và giáo sư Manuel Blum dẫn đầu.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": [
            "c010"
          ]
        }
      ]
    },
    {
      "id": "s12",
      "chapter": "chuong-1",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b023",
          "text": "Yahoo! dùng một CAPTCHA của nhóm, bắt người dùng đọc một chữ bị bóp méo.",
          "spoken": null,
          "cue": null,
          "pause_ms": 500,
          "sfx": null,
          "claims": [
            "c007"
          ]
        }
      ]
    },
    {
      "id": "s13",
      "chapter": "chuong-1",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b024",
          "text": "Năm 2003, nhóm công bố định nghĩa chính thức.",
          "spoken": null,
          "cue": null,
          "pause_ms": 300,
          "sfx": null,
          "claims": [
            "c010"
          ]
        },
        {
          "id": "b025",
          "text": "CAPTCHA là bài kiểm tra mà phần lớn con người vượt qua được.",
          "spoken": null,
          "cue": null,
          "pause_ms": 300,
          "sfx": null,
          "claims": [
            "c010"
          ]
        },
        {
          "id": "b026",
          "text": "Nhưng chương trình máy tính hiện tại thì không.",
          "spoken": null,
          "cue": null,
          "pause_ms": 600,
          "sfx": null,
          "claims": [
            "c010"
          ]
        }
      ]
    },
    {
      "id": "s14",
      "chapter": "chuong-1",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b027",
          "text": "Chữ hiện tại ấy rất quan trọng. Nó sẽ quay lại ở cuối câu chuyện.",
          "spoken": null,
          "cue": null,
          "pause_ms": 900,
          "sfx": null,
          "claims": []
        }
      ]
    },
    {
      "id": "s15",
      "chapter": "chuong-2",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b028",
          "text": "Cái tên CAPTCHA là viết tắt của một cụm từ khá dài.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": [
            "c011"
          ]
        },
        {
          "id": "b029",
          "text": "Dịch ra là phép thử Turing công khai, hoàn toàn tự động, để phân biệt máy tính với con người.",
          "spoken": null,
          "cue": null,
          "pause_ms": 500,
          "sfx": null,
          "claims": [
            "c011"
          ]
        }
      ]
    },
    {
      "id": "s16",
      "chapter": "chuong-2",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b030",
          "text": "Phép thử Turing là gì?",
          "spoken": null,
          "cue": null,
          "pause_ms": 300,
          "sfx": null,
          "claims": [
            "c012"
          ]
        },
        {
          "id": "b031",
          "text": "Năm 1950, nhà toán học Alan Turing đăng một bài trên tạp chí Mind.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": [
            "c012"
          ]
        },
        {
          "id": "b032",
          "text": "Ông đưa ra trò chơi bắt chước: người hỏi chỉ nhắn chữ với hai bên giấu mặt, rồi đoán bên nào là máy.",
          "spoken": null,
          "cue": null,
          "pause_ms": 500,
          "sfx": null,
          "claims": [
            "c012"
          ]
        }
      ]
    },
    {
      "id": "s17",
      "chapter": "chuong-2",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b033",
          "text": "CAPTCHA lật ngược trò chơi đó.",
          "spoken": null,
          "cue": null,
          "pause_ms": 300,
          "sfx": null,
          "claims": [
            "c011"
          ]
        },
        {
          "id": "b034",
          "text": "Ở đây, người chấm là máy. Còn người bị thử là bạn.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": []
        },
        {
          "id": "b035",
          "text": "Bạn phải chứng minh với một cái máy rằng bạn không phải là máy.",
          "spoken": null,
          "cue": null,
          "pause_ms": 600,
          "sfx": null,
          "claims": []
        }
      ]
    },
    {
      "id": "s18",
      "chapter": "chuong-2",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b036",
          "text": "Và bài thi này chỉ có tác dụng khi câu hỏi là thứ máy chưa làm được.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": [
            "c010"
          ]
        },
        {
          "id": "b037",
          "text": "Câu hỏi nào máy làm được rồi thì phải đổi. Đó là lý do câu đố cứ thay đổi suốt hơn hai mươi năm.",
          "spoken": null,
          "cue": null,
          "pause_ms": 900,
          "sfx": null,
          "claims": []
        }
      ]
    },
    {
      "id": "s19",
      "chapter": "chuong-3",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b038",
          "text": "Đầu thế kỷ này, CAPTCHA chủ yếu là chữ méo. Và nó tốn rất nhiều thời gian của loài người.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": [
            "c007",
            "c005"
          ]
        }
      ]
    },
    {
      "id": "s20",
      "chapter": "chuong-3",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b039",
          "text": "Theo Luis von Ahn và cộng sự, năm 2008 mỗi ngày người ta gõ hơn 100 triệu CAPTCHA.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": [
            "c005"
          ]
        },
        {
          "id": "b040",
          "text": "Cộng lại là hàng trăm nghìn giờ người mỗi ngày, gõ xong là bỏ.",
          "spoken": null,
          "cue": null,
          "pause_ms": 500,
          "sfx": null,
          "claims": [
            "c005"
          ]
        }
      ]
    },
    {
      "id": "s21",
      "chapter": "chuong-3",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b041",
          "text": "Von Ahn nghĩ: sao không dùng chính chỗ thời gian ấy để làm một việc có ích?",
          "spoken": null,
          "cue": null,
          "pause_ms": 500,
          "sfx": null,
          "claims": [
            "c005"
          ]
        }
      ]
    },
    {
      "id": "s22",
      "chapter": "chuong-3",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b042",
          "text": "Việc có ích đó là đọc sách báo cũ đã quét, những trang giấy ố vàng mà máy đọc không ra.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": [
            "c013"
          ]
        },
        {
          "id": "b043",
          "text": "Ý tưởng ấy tên là reCAPTCHA.",
          "spoken": null,
          "cue": null,
          "pause_ms": 500,
          "sfx": null,
          "claims": [
            "c013"
          ]
        }
      ]
    },
    {
      "id": "s23",
      "chapter": "chuong-3",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b044",
          "text": "Mẹo nằm ở chỗ: mỗi lần, bạn được đưa hai chữ.",
          "spoken": null,
          "cue": null,
          "pause_ms": 300,
          "sfx": null,
          "claims": [
            "c013"
          ]
        },
        {
          "id": "b045",
          "text": "Một chữ máy đã biết đáp án, để kiểm tra bạn là người.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": [
            "c013"
          ]
        },
        {
          "id": "b046",
          "text": "Chữ kia là chữ mà phần mềm nhận dạng chữ không đọc được.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": [
            "c013"
          ]
        }
      ]
    },
    {
      "id": "s24",
      "chapter": "chuong-3",
      "type": "term-card",
      "props": {},
      "holdMs": 0,
      "sfx": null,
      "beats": [
        {
          "id": "b047",
          "text": "Gõ đúng chữ kiểm tra, thì câu trả lời của bạn cho chữ kia được tính như một lá phiếu.",
          "spoken": null,
          "cue": null,
          "pause_ms": 400,
          "sfx": null,
          "claims": [
            "c013"
          ]
        },
        {
          "id": "b048",
          "text": "Nhiều người cùng bỏ phiếu cho một chữ, và chữ ấy được đọc ra.",
          "spoken": null,
          "cue": null,
          "pause_ms": 500,
          "sfx": null,
          "claims": []
        }
      ]
    },
    {
      "id": "s25",
      "chapter": "chuong-3",
      "type": "term-card",
