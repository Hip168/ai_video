<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Mẫu LaunchAgent chạy scripts/run-daily.sh mỗi ngày (D24).
  Cài: chép thành ~/Library/LaunchAgents/com.aivideo.daily.plist, thay các chỗ /DUONG/DAN/REPO, /Users/TEN_MAY
  (thư mục nhà; `which claude uv node` cho biết thư mục thật) và TOKEN_CUA_CLAUDE_SETUP_TOKEN, chmod 600 file đó, rồi
  launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.aivideo.daily.plist
  Không commit bản đã điền token. Không dán giá trị token vào log, lệnh hay báo cáo.
  Cần Claude Code từ v2.1.259 trở lên (run-daily.sh dùng cờ --permission-prompts).
  Thư mục ~/Library/Logs/aivideo/ phải có sẵn trước khi bootstrap (run-daily.sh tự tạo ở lượt đầu,
  nhưng launchd mở file log trước khi script chạy): mkdir -p ~/Library/Logs/aivideo
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.aivideo.daily</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/DUONG/DAN/REPO/scripts/run-daily.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <!-- claude: ~/.local/bin; uv, node: /opt/homebrew/bin -->
    <string>/Users/TEN_MAY/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>CLAUDE_CODE_OAUTH_TOKEN</key>
    <string>TOKEN_CUA_CLAUDE_SETUP_TOKEN</string>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/TEN_MAY/Library/Logs/aivideo/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/TEN_MAY/Library/Logs/aivideo/launchd.err.log</string>
</dict>
</plist>
